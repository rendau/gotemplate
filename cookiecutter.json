{
  "project_slug": "myservice",
  "module_owner": "github.com/rendau",
  "install_skills": true,
  "__prompts__": {
    "install_skills": "Установить скиллы Claude Code (go-service-skill)?"
  },
  "__go_module": "{{ cookiecutter.module_owner }}/{{ cookiecutter.project_slug }}",
  "__proto_pkg": "{{ cookiecutter.project_slug }}_v1",
  "__ci_owner": "{{ cookiecutter.module_owner.split('/')[1:] | join('/') }}",
  "_copy_without_render": [
    ".claude/*",
    "pkg/proto/*",
    "vendor-proto/*",
    "go.sum"
  ]
}
